<Window x:Class="CodexUsageMonitor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" Title="Codex Usage" Width="260" Height="440" MinWidth="240" MinHeight="420" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="True" SizeChanged="Window_SizeChanged" Foreground="#EBEDF6" FontFamily="Segoe UI" UseLayoutRounding="True">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Foreground" Value="#BBC0D0"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontSize" Value="10"/><Setter Property="Padding" Value="5,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="p:Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="p:Thumb"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ProgressBar"><Setter Property="Height" Value="4"/><Setter Property="Background" Value="#303340"/><Setter Property="Foreground" Value="#9390FF"/><Setter Property="BorderThickness" Value="0"/></Style>
</Window.Resources><Grid><Border x:Name="WidgetBorder" Margin="1" CornerRadius="10" Background="#F2181A22" BorderBrush="#454653" BorderThickness="1">
<Border.ContextMenu><ContextMenu Opened="WidgetContextMenu_Opened"><MenuItem Header="Bloquear posición" IsCheckable="True" Click="ToggleLockMenu_Click"/><MenuItem Header="Tamaño compacto" Click="UseCompactSizeMenu_Click"/><MenuItem Header="Tamaño normal" Click="UseNormalSizeMenu_Click"/><MenuItem Header="Uso de cuenta" Click="ManagePlanButton_Click"/><MenuItem Header="Cerrar" Click="CloseMenuItem_Click"/></ContextMenu></Border.ContextMenu>
<Grid x:Name="RootLayout" Margin="14,10"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="74"/><RowDefinition Height="43"/><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="49"/><RowDefinition Height="61"/><RowDefinition Height="25"/></Grid.RowDefinitions>
<Grid MouseLeftButtonDown="Header_MouseLeftButtonDown"><TextBlock x:Name="TitleText" Text="●  CODEX / USO" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="×" HorizontalAlignment="Right" Click="CloseButton_Click"/></Grid>
<Grid Grid.Row="1" Margin="0,5,0,0"><StackPanel><TextBlock Text="SEMANA · RESTANTE" FontSize="9" Foreground="#A5A8BD"/><TextBlock x:Name="WeeklyText" Text="—" FontSize="32" FontWeight="SemiBold"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Reinicio en" FontSize="10" Foreground="#9095A8"/><TextBlock x:Name="ResetText" Text="—" FontSize="12" Margin="0,3,0,0"/></StackPanel><ProgressBar x:Name="WeeklyBar" VerticalAlignment="Bottom" Maximum="100"/></Grid>
<Grid Grid.Row="2" Margin="0,10,0,0"><TextBlock Text="5 horas restantes" FontSize="11" Foreground="#B4B7C7"/><TextBlock x:Name="FiveHourText" Text="—" FontSize="11" HorizontalAlignment="Right"/><ProgressBar x:Name="FiveHourBar" VerticalAlignment="Bottom" Margin="0,0,0,7" Maximum="100"/></Grid>
<UniformGrid Grid.Row="3" Columns="3" Margin="0,3,0,0"><StackPanel><TextBlock Text="Créditos" FontSize="9" Foreground="#9095A8"/><TextBlock x:Name="CreditsText" Text="—" FontSize="12"/></StackPanel><StackPanel><TextBlock Text="Racha · días" FontSize="9" Foreground="#9095A8"/><TextBlock x:Name="StreakText" Text="—" FontSize="12"/></StackPanel><StackPanel><TextBlock Text="Tokens total" FontSize="9" Foreground="#9095A8"/><TextBlock x:Name="LifetimeTokensText" Text="—" FontSize="12"/></StackPanel></UniformGrid>
<Grid Grid.Row="4" Margin="0,3,0,3"><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="ACTIVIDAD" FontSize="9" Foreground="#A5A8BD" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Range7Button" Content="7d" Click="Range7Button_Click"/><Button x:Name="Range30Button" Content="30d" Click="Range30Button_Click"/><Button x:Name="RangeAllButton" Content="Todo" Click="RangeAllButton_Click"/></StackPanel><TextBlock x:Name="ChartSummaryText" Grid.Row="1" Text="Esperando datos" FontSize="9" Foreground="#9095A8"/><Canvas x:Name="TokenChart" Grid.Row="2" ClipToBounds="True" SizeChanged="TokenChart_SizeChanged"/></Grid>
<Border Grid.Row="5" BorderBrush="#30333F" BorderThickness="0,1,0,0" Padding="0,3,0,0" Cursor="Hand" MouseLeftButtonUp="OpenLocalDetails" ToolTip="Ver ranking completo. Tokens locales; no equivalen a créditos."><StackPanel x:Name="ModelListPanel"/></Border>
<Border Grid.Row="6" Background="#242733" CornerRadius="6" Padding="8,6"><Grid><Grid.RowDefinitions><RowDefinition Height="15"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="RITMO SEMANAL" FontSize="9" Foreground="#AEAAF7"/><StackPanel x:Name="ProjectListPanel" Grid.Row="1"/></Grid></Border>
<Border x:Name="StatusBorder" Grid.Row="7" Margin="0,5,0,0"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="#9095A8" Margin="0,0,5,0"/><TextBlock x:Name="StatusText" Text="CONECTANDO" FontSize="9"/><TextBlock x:Name="StatusSubtitleText" Visibility="Collapsed"/></StackPanel><TextBlock Text="Avisos 70 · 50 · 30%" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9" Foreground="#9095A8"/></Grid></Border>
</Grid></Border><p:Thumb Width="5" HorizontalAlignment="Right" Cursor="SizeWE" DragDelta="ResizeRight_DragDelta"/><p:Thumb Height="5" VerticalAlignment="Bottom" Cursor="SizeNS" DragDelta="ResizeBottom_DragDelta"/><p:Thumb Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeCorner_DragDelta"/></Grid></Window>
